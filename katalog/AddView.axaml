<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="500"
             x:Class="katalog.AddView">
    <Grid Margin="20">
        <StackPanel Spacing="14" MaxWidth="400" HorizontalAlignment="Left">
            <TextBlock Text="Dodaj nową pozycję" FontSize="20" FontWeight="Bold" />
            
            <StackPanel Spacing="4">
                <TextBlock Text="Tytuł:" FontWeight="SemiBold" />
                <TextBox Name="TitleInput" PlaceholderText="np. Władca Pierścieni" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Rok wydania:" FontWeight="SemiBold" />
                <TextBox Name="YearInput" PlaceholderText="np. 2001" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Ocena (1-10):" FontWeight="SemiBold" />
                <TextBox Name="RatingInput" PlaceholderText="np. 9" />
            </StackPanel>

            <TextBlock Name="ErrorText" Foreground="Red" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="OnSaveClick" Width="100">Zapisz</Button>
                <Button Click="OnCancelClick" Width="100">Anuluj</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
